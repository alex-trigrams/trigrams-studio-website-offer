# Allowlist: only the public site is uploaded to Vercel. Anything not listed
# below (the brief, build scripts, README, .claude, editor files) stays local.
/*
!/*.html
!/ads
!/middleware.js
!/assets
!/.well-known
!/site.js
!/styles.css
!/robots.txt
!/sitemap.xml
!/llms.txt
!/vercel.json

# Never upload these, even inside allowed folders
.DS_Store
assets/vsl-raw.mov
