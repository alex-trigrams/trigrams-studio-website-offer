{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-899ZNv1Uti5ont1CYn9ZIm0AxNq/u+uxM4bGaFQBC/8='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(styles.css|site.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/clients",
      "destination": "/work.html",
      "permanent": true
    },
    {
      "source": "/clients.html",
      "destination": "/work.html",
      "permanent": true
    },
    {
      "source": "/case-studies",
      "destination": "/work.html",
      "permanent": true
    },
    {
      "source": "/case-studies.html",
      "destination": "/work.html",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/work.html",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/work.html",
      "permanent": false
    },
    {
      "source": "/showreel",
      "destination": "/work.html",
      "permanent": false
    },
    {
      "source": "/reel",
      "destination": "/work.html",
      "permanent": false
    },
    {
      "source": "/services",
      "destination": "/system.html",
      "permanent": true
    },
    {
